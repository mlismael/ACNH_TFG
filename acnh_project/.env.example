# Copy this file to .env.local (development) or .env.production (production)
# and configure the values accordingly

APP_ENV=local
APP_DEBUG=true

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acnh_project
DB_USER=root
DB_PASSWORD=

# Nookipedia API
NOOKIPEDIA_API_KEY=your_key_here
NOOKIPEDIA_BASE_URL=https://api.nookipedia.com
